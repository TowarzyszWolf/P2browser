set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(CMAKE_C_COMPILER gcc)
set(CMAKE_CXX_COMPILER g++)
set(CMAKE_C_FLAGS_INIT "-m32 -march=pentium2 -mno-sse -mno-sse2 -mfpmath=387")
set(CMAKE_CXX_FLAGS_INIT "-m32 -march=pentium2 -mno-sse -mno-sse2 -mfpmath=387")
set(CMAKE_ASM_FLAGS_INIT "-m32 -march=pentium2 -mno-sse -mno-sse2 -mfpmath=387")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m32")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-m32")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-m32")
set(ICU_INCLUDE_DIR "/usr/include" CACHE PATH "Target ICU headers")
set(ICU_DATA_LIBRARY_RELEASE "/usr/lib/i386-linux-gnu/libicudata.so" CACHE FILEPATH "Target ICU data")
set(ICU_I18N_LIBRARY_RELEASE "/usr/lib/i386-linux-gnu/libicui18n.so" CACHE FILEPATH "Target ICU i18n")
set(ICU_UC_LIBRARY_RELEASE "/usr/lib/i386-linux-gnu/libicuuc.so" CACHE FILEPATH "Target ICU uc")
